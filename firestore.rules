rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasAdminProfile() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isStaff() {
      return hasAdminProfile() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['super-admin', 'editor', 'event-manager'];
    }

    function isSuperAdmin() {
      return hasAdminProfile() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super-admin';
    }

    match /admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /eventReservations/{reservationId} {
      allow create: if request.resource.data.eventId is string
        && request.resource.data.name is string
        && request.resource.data.email is string;
      allow read, update, delete: if isStaff();
    }

    match /donations/{donationId} {
      allow create: if request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow read: if isStaff();
      allow update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    match /pageViews/{viewId} {
      allow create: if request.resource.data.path is string;
      allow read: if isStaff();
      allow update, delete: if isSuperAdmin();
    }

    match /plugins/{pluginId} {
      allow read: if isStaff();
      allow create, update, delete: if isSuperAdmin();
    }

    match /events/{eventId} {
      allow update: if signedIn() == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reservedSeats'])
        && request.resource.data.reservedSeats == resource.data.reservedSeats + 1
        && (resource.data.capacity == 0 || request.resource.data.reservedSeats <= resource.data.capacity);
      allow create, update: if isStaff();
      allow read: if true;
      allow delete: if isSuperAdmin();
    }

    match /{collectionName}/{documentId} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if isSuperAdmin();
    }
  }
}